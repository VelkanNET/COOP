rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isStaff() {
      return signed() && request.auth.token.email_verified == true
        && request.auth.token.email == 'negocios.wagnermarques@gmail.com';
    }
    function activeUser(userId) {
      let profile = get(/databases/$(db)/documents/users/$(userId)).data;
      return signed() && profile.get('status', '') == 'ok'
        && (profile.get('plan', '') == 'free'
          || (profile.get('plan', '') in ['basic', 'standard']
            && (profile.get('subscriptionStatus', '') == 'staff-managed'
              || (profile.get('planExpiresAt', null) is timestamp
                && profile.get('planExpiresAt', null) > request.time))));
    }
    function active() { return activeUser(uid()); }
    function ownerPlan(owner) {
      let profile = get(/databases/$(db)/documents/users/$(owner)).data;
      return profile.get('status', '') == 'ok'
          && profile.get('plan', '') in ['basic', 'standard']
          && (profile.get('subscriptionStatus', '') == 'staff-managed'
            || (profile.get('planExpiresAt', null) is timestamp
              && profile.get('planExpiresAt', null) > request.time))
        ? profile.get('plan', 'free') : 'free';
    }
    function memberLimit(owner) {
      let plan = ownerPlan(owner);
      return plan == 'standard' ? 2147483647 : plan == 'basic' ? 35 : 10;
    }
    function tableLimit(owner) {
      let plan = ownerPlan(owner);
      return plan == 'standard' ? 2147483647 : plan == 'basic' ? 5 : 1;
    }
    function agendaLimit(owner) {
      let plan = ownerPlan(owner);
      return plan == 'standard' ? 2147483647 : plan == 'basic' ? 3 : 1;
    }
    function maxFileBytes(plan) {
      return plan == 'standard' ? 10485760 : plan == 'basic' ? 5242880 : 2097152;
    }
    function chunkKey(index) {
      let keys = [
        '0000', '0001', '0002', '0003', '0004', '0005', '0006', '0007',
        '0008', '0009', '0010', '0011', '0012', '0013', '0014', '0015',
        '0016', '0017', '0018', '0019'
      ];
      return index is int && index >= 0 && index < keys.size() ? keys[index] : '';
    }
    function encodedChunkSize(byteCount) {
      return byteCount % 3 == 0 ? (byteCount / 3) * 4
        : byteCount % 3 == 1 ? ((byteCount - 1) / 3) * 4 + 4
          : ((byteCount - 2) / 3) * 4 + 4;
    }
    function billingFields() {
      return ['role', 'plan', 'status', 'planPeriod', 'planExpiresAt',
        'lastPaymentAt', 'subscriptionStatus', 'subscriptionPlanKey',
        'preapprovalId', 'pendingBillingIntentId', 'lastCheckoutAt', 'updatedAt',
        'followerCount', 'followingCount', 'followerChange', 'followingChange',
        'extraSuffixId', 'verified'];
    }
    function reservedCreateFields() {
      return ['planPeriod', 'planExpiresAt', 'lastPaymentAt',
        'subscriptionStatus', 'subscriptionPlanKey', 'preapprovalId',
        'pendingBillingIntentId', 'lastCheckoutAt', 'updatedAt',
        'followerCount', 'followingCount', 'followerChange', 'followingChange',
        'extraSuffixId', 'verified'];
    }
    function followingCounterUpdate(u) {
      let change = request.resource.data.get('followingChange', {});
      let oldCount = resource.data.get('followingCount', 0);
      return signed() && uid() == u
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount', 'followingChange'])
        && change is map && change.keys().hasAll(['action', 'targetUid'])
        && change.get('targetUid', '') is string && change.get('targetUid', '') != u
        && request.resource.data.get('followingCount', -1) is int
        && ((change.get('action', '') == 'follow'
              && request.resource.data.get('followingCount', -1) == oldCount + 1
              && !exists(/databases/$(db)/documents/users/$(u)/following/$(change.get('targetUid', '')))
              && existsAfter(/databases/$(db)/documents/users/$(u)/following/$(change.get('targetUid', '')))
              && !exists(/databases/$(db)/documents/users/$(change.get('targetUid', ''))/followers/$(u))
              && existsAfter(/databases/$(db)/documents/users/$(change.get('targetUid', ''))/followers/$(u)))
          || (change.get('action', '') == 'unfollow'
              && request.resource.data.get('followingCount', -1) == (oldCount > 0 ? oldCount - 1 : 0)
              && exists(/databases/$(db)/documents/users/$(u)/following/$(change.get('targetUid', '')))
              && !existsAfter(/databases/$(db)/documents/users/$(u)/following/$(change.get('targetUid', '')))
              && exists(/databases/$(db)/documents/users/$(change.get('targetUid', ''))/followers/$(u))
              && !existsAfter(/databases/$(db)/documents/users/$(change.get('targetUid', ''))/followers/$(u))));
    }
    function followerCounterUpdate(u) {
      let change = request.resource.data.get('followerChange', {});
      let follower = /databases/$(db)/documents/users/$(u)/followers/$(uid());
      let following = /databases/$(db)/documents/users/$(uid())/following/$(u);
      let oldCount = resource.data.get('followerCount', 0);
      return signed() && uid() != u
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount', 'followerChange'])
        && change is map && change.get('followerUid', '') == uid()
        && change.get('action', '') in ['follow', 'unfollow']
        && request.resource.data.get('followerCount', -1) is int
        && ((change.get('action', '') == 'follow'
              && request.resource.data.get('followerCount', -1) == oldCount + 1
              && !exists(follower) && existsAfter(follower)
              && !exists(following) && existsAfter(following))
          || (change.get('action', '') == 'unfollow'
              && request.resource.data.get('followerCount', -1) == (oldCount > 0 ? oldCount - 1 : 0)
              && exists(follower) && !existsAfter(follower)
              && exists(following) && !existsAfter(following)));
    }
    function coop(c) { return get(/databases/$(db)/documents/coops/$(c)).data; }
    function member(c) { return signed() && request.auth.token.email in coop(c).members; }
    function retainedCoopData(c, messageTime) {
      return isStaff() || ownerPlan(coop(c).get('ownerUid', uid())) != 'free'
        || messageTime >= request.time.toMillis() - 1209600000;
    }
    function assetData(assetId) {
      return get(/databases/$(db)/documents/assets/$(assetId)).data;
    }
    function attachableCoopAsset(assetId, c, authorUid) {
      return assetId == '' || (exists(/databases/$(db)/documents/assets/$(assetId))
        && assetData(assetId).ready == true
        && assetData(assetId).kind == 'coop'
        && assetData(assetId).coopId == c
        && assetData(assetId).uid == authorUid);
    }
    function attachablePostAsset(assetId) {
      return assetId == '' || (exists(/databases/$(db)/documents/assets/$(assetId))
        && assetData(assetId).ready == true
        && assetData(assetId).kind == 'post'
        && assetData(assetId).uid == uid());
    }
    function validAssetCreate() {
      let file = request.resource.data;
      let ownedPlan = ownerPlan(uid());
      return active()
        && file.keys().hasOnly([
          'uid', 'email', 'kind', 'coopId', 'contentType', 'name', 'size',
          'chunkCount', 'uploadedBytes', 'uploadedChunks', 'createdAt', 'ready'
        ])
        && file.keys().hasAll([
          'uid', 'email', 'kind', 'coopId', 'contentType', 'name', 'size',
          'chunkCount', 'uploadedBytes', 'uploadedChunks', 'createdAt', 'ready'
        ])
        && file.uid == uid()
        && file.email == request.auth.token.email
        && file.name is string && file.name.size() <= 120
        && file.size is int && file.size > 0
        && file.chunkCount is int && file.chunkCount >= 1 && file.chunkCount <= 20
        && file.uploadedBytes == 0 && file.uploadedChunks == 0
        && file.createdAt is int
        && file.ready == false
        && (file.chunkCount - 1) * 524288 < file.size
        && file.chunkCount * 524288 >= file.size
        && file.contentType is string
        && ((file.kind == 'profile'
              && file.coopId == ''
              && file.contentType.matches('image/.*')
              && file.size <= maxFileBytes(ownedPlan))
          || (file.kind == 'post'
              && file.coopId == ''
              && ownedPlan in ['basic', 'standard']
              && file.contentType.matches('image/.*')
              && file.size <= maxFileBytes(ownedPlan))
          || (file.kind == 'coop'
              && file.coopId is string
              && member(file.coopId)
              && activeUser(coop(file.coopId).ownerUid)
              && file.size <= maxFileBytes(ownerPlan(coop(file.coopId).ownerUid))
              && (ownerPlan(coop(file.coopId).ownerUid) != 'free'
                ? file.contentType.matches('image/.*')
                    || file.contentType == 'application/pdf'
                    || file.contentType == 'text/plain'
                : file.contentType == 'text/plain')));
    }
    function canReadAsset(assetId) {
      let file = assetData(assetId);
      return (signed() && uid() == file.uid) || (file.ready == true
        && (file.kind in ['profile', 'post'] || member(file.coopId) || isStaff()));
    }
    function canDeleteAsset(assetId) {
      let file = assetData(assetId);
      return isStaff() || uid() == file.uid
        || (file.kind == 'coop' && member(file.coopId)
          && file.createdAt <= request.time.toMillis() - 1209600000);
    }
    function assetProgressUpdate(assetId) {
      let nextIndex = resource.data.uploadedChunks;
      let chunkPath = /databases/$(db)/documents/assets/$(assetId)/chunks/$(chunkKey(nextIndex));
      return signed() && active() && resource.data.uid == uid()
        && resource.data.ready == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uploadedBytes', 'uploadedChunks'])
        && request.resource.data.uploadedChunks == nextIndex + 1
        && existsAfter(chunkPath)
        && getAfter(chunkPath).data.index == nextIndex
        && request.resource.data.uploadedBytes == resource.data.uploadedBytes + getAfter(chunkPath).data.bytes;
    }
    function finishAssetUpload() {
      return signed() && active() && resource.data.uid == uid()
        && resource.data.ready == false && request.resource.data.ready == true
        && request.resource.data.uploadedBytes == resource.data.size
        && request.resource.data.uploadedChunks == resource.data.chunkCount
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready']);
    }
    function validAssetChunk(assetId, chunkId) {
      let file = assetData(assetId);
      let chunk = request.resource.data;
      let expectedBytes = chunk.index == file.chunkCount - 1
        ? file.size - (file.chunkCount - 1) * 524288 : 524288;
      return signed() && active() && file.uid == uid() && file.ready == false
        && chunkId == chunkKey(file.uploadedChunks)
        && chunk.keys().hasOnly(['index', 'bytes', 'data'])
        && chunk.keys().hasAll(['index', 'bytes', 'data'])
        && chunk.index is int && chunk.index == file.uploadedChunks
        && chunk.bytes is int && chunk.bytes == expectedBytes
        && chunk.data is string && chunk.data.size() == encodedChunkSize(chunk.bytes)
        && chunk.data.size() <= 700000;
    }
    function admin(c) {
      return signed() && (request.auth.token.email == coop(c).owner
        || request.auth.token.email in coop(c).mods);
    }
    function postLikeUpdate() {
      let oldLikes = resource.data.likes;
      let newLikes = request.resource.data.likes;
      let email = request.auth.token.email;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && oldLikes is list && newLikes is list
        && ((newLikes.size() == oldLikes.size() + 1
              && newLikes.hasAll(oldLikes)
              && email in newLikes && !(email in oldLikes))
          || (newLikes.size() + 1 == oldLikes.size()
              && oldLikes.hasAll(newLikes)
              && email in oldLikes && !(email in newLikes)));
    }
    function postCommentUpdate() {
      let oldComments = resource.data.comments;
      let newComments = request.resource.data.comments;
      let added = newComments[oldComments.size()];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
        && oldComments is list && newComments is list
        && newComments.size() == oldComments.size() + 1
        && newComments.hasAll(oldComments)
        && added.uid == uid()
        && added.f == request.auth.token.email
        && added.x is string && added.x.size() > 0 && added.x.size() <= 2000
        && added.t is int;
    }

    match /users/{u} {
      allow read: if true;
      allow create: if signed() && uid() == u && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.plan == 'free' && request.resource.data.status == 'ok'
        && !request.resource.data.keys().hasAny(reservedCreateFields());
      allow update: if isStaff() || (uid() == u
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(billingFields()))
        || followingCounterUpdate(u) || followerCounterUpdate(u);
      allow delete: if isStaff();
      match /following/{target} {
        allow read: if signed();
        allow create: if signed() && uid() == u && target != uid()
          && request.resource.data.keys().hasAll([
            'fromUid', 'fromEmail', 'fromName', 'toUid', 'toEmail', 'toName', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'fromUid', 'fromEmail', 'fromName', 'toUid', 'toEmail', 'toName', 'createdAt'
          ])
          && request.resource.data.fromUid == uid()
          && request.resource.data.fromEmail == request.auth.token.email
          && request.resource.data.toUid == target
          && request.resource.data.toEmail == get(/databases/$(db)/documents/users/$(target)).data.email
          && request.resource.data.fromName is string
          && request.resource.data.toName is string
          && request.resource.data.createdAt is int
          && getAfter(/databases/$(db)/documents/users/$(u)).data.keys().hasAll([
              'followingCount', 'followingChange'
            ])
          && getAfter(/databases/$(db)/documents/users/$(u)).data.diff(
              get(/databases/$(db)/documents/users/$(u)).data).affectedKeys().hasOnly([
                'followingCount', 'followingChange'
              ])
          && getAfter(/databases/$(db)/documents/users/$(u)).data.get('followingChange', {}).get('targetUid', '') == target
          && getAfter(/databases/$(db)/documents/users/$(u)).data.get('followingChange', {}).get('action', '') == 'follow';
        allow update: if false;
        allow delete: if signed() && uid() == u && resource.data.fromUid == uid()
          && getAfter(/databases/$(db)/documents/users/$(u)).data.diff(
              get(/databases/$(db)/documents/users/$(u)).data).affectedKeys().hasOnly([
                'followingCount', 'followingChange'
              ])
          && getAfter(/databases/$(db)/documents/users/$(u)).data.get('followingChange', {}).get('targetUid', '') == target
          && getAfter(/databases/$(db)/documents/users/$(u)).data.get('followingChange', {}).get('action', '') == 'unfollow';
      }
      match /followers/{follower} {
        allow read: if signed();
        allow create: if signed() && uid() == follower && follower != u
          && request.resource.data.keys().hasAll([
            'fromUid', 'fromEmail', 'fromName', 'toUid', 'toEmail', 'toName', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'fromUid', 'fromEmail', 'fromName', 'toUid', 'toEmail', 'toName', 'createdAt'
          ])
          && request.resource.data.fromUid == uid()
          && request.resource.data.fromEmail == request.auth.token.email
          && request.resource.data.toUid == u
          && request.resource.data.toEmail == get(/databases/$(db)/documents/users/$(u)).data.email
          && request.resource.data.fromName is string
          && request.resource.data.toName is string
          && request.resource.data.createdAt is int
          && getAfter(/databases/$(db)/documents/users/$(u)).data.keys().hasAll([
              'followerCount', 'followerChange'
            ])
          && getAfter(/databases/$(db)/documents/users/$(u)).data.diff(
              get(/databases/$(db)/documents/users/$(u)).data).affectedKeys().hasOnly([
                'followerCount', 'followerChange'
              ])
          && getAfter(/databases/$(db)/documents/users/$(u)).data.get('followerChange', {}).get('followerUid', '') == follower
          && getAfter(/databases/$(db)/documents/users/$(u)).data.get('followerChange', {}).get('action', '') == 'follow';
        allow update: if false;
        allow delete: if signed() && uid() == follower && resource.data.fromUid == uid()
          && getAfter(/databases/$(db)/documents/users/$(u)).data.diff(
              get(/databases/$(db)/documents/users/$(u)).data).affectedKeys().hasOnly([
                'followerCount', 'followerChange'
              ])
          && getAfter(/databases/$(db)/documents/users/$(u)).data.get('followerChange', {}).get('followerUid', '') == follower
          && getAfter(/databases/$(db)/documents/users/$(u)).data.get('followerChange', {}).get('action', '') == 'unfollow';
      }
      match /private/{d} { allow read, write: if d != 'billing' && (uid() == u || isStaff()); }
      match /private/billing { allow read, write: if false; }
    }

    match /suffixes/{suffixId} {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['label', 'color', 'createdAt'])
        && request.resource.data.keys().hasAll(['label', 'color', 'createdAt'])
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 18
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.createdAt is int;
      allow delete: if isStaff();
    }

    match /coops/{c} {
      allow read: if signed() && (request.auth.token.email in resource.data.members || isStaff());
      allow create: if active() && request.resource.data.owner == request.auth.token.email
        && request.resource.data.ownerUid == uid()
        && request.resource.data.members == [request.auth.token.email] && request.resource.data.mods == []
        && request.resource.data.members.size() <= memberLimit(uid())
        && request.resource.data.tables is list && request.resource.data.tables.size() <= tableLimit(uid())
        && request.resource.data.ev is list && request.resource.data.ev.size() <= agendaLimit(uid());
      allow update: if isStaff() || (signed()
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.ownerUid == resource.data.get('ownerUid', uid())
        && request.resource.data.owner in request.resource.data.members
        && request.resource.data.members.size() <= memberLimit(resource.data.get('ownerUid', uid()))
        && request.resource.data.tables is list
        && request.resource.data.tables.size() <= tableLimit(resource.data.get('ownerUid', uid()))
        && request.resource.data.ev is list
        && request.resource.data.ev.size() <= agendaLimit(resource.data.get('ownerUid', uid()))
        && request.resource.data.mods.size() <= 2
        && (request.auth.token.email == resource.data.owner
            || (request.auth.token.email in resource.data.mods && request.resource.data.mods == resource.data.mods)
            || (request.auth.token.email in resource.data.members
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'ch', 'tables', 'ev', 'desc', 'link', 'pic', 'name'
              ])
              && request.resource.data.members == resource.data.members
              && request.resource.data.mods == resource.data.mods)));
      allow delete: if isStaff() || (signed() && request.auth.token.email == resource.data.owner);

      match /channels/{ch} {
        allow read: if member(c) || isStaff();
        allow create, update, delete: if admin(c) || isStaff();
        match /messages/{m} {
          allow read: if (member(c) && retainedCoopData(c, resource.data.t)) || isStaff();
          allow create: if member(c) && active()
            && request.resource.data.keys().hasOnly(['from', 'f', 'name', 'x', 't', 'kind', 'assetPath'])
            && request.resource.data.keys().hasAll(['from', 'f', 'name', 'x', 't', 'kind', 'assetPath'])
            && request.resource.data.from == uid()
            && request.resource.data.f == request.auth.token.email
            && request.resource.data.name is string && request.resource.data.name.size() <= 50
            && request.resource.data.x is string && request.resource.data.x.size() <= 5000
            && request.resource.data.t is int
            && request.resource.data.kind in ['', 'image', 'file']
            && request.resource.data.assetPath is string
            && attachableCoopAsset(request.resource.data.assetPath, c, uid());
          allow delete: if admin(c) || isStaff() || resource.data.from == uid();
        }
      }
      match /feed/{entry} {
        allow read: if (member(c) && retainedCoopData(c, resource.data.t)) || isStaff();
        allow create: if member(c) && active()
          && request.resource.data.keys().hasOnly(['by', 'f', 'name', 'x', 't', 'assetPath', 'assetKind'])
          && request.resource.data.keys().hasAll(['by', 'f', 'name', 'x', 't', 'assetPath', 'assetKind'])
          && request.resource.data.by == uid()
          && request.resource.data.f == request.auth.token.email
          && request.resource.data.name is string && request.resource.data.name.size() <= 50
          && request.resource.data.x is string && request.resource.data.x.size() <= 5000
          && request.resource.data.t is int
          && request.resource.data.assetPath is string
          && request.resource.data.assetKind in ['', 'image', 'file']
          && attachableCoopAsset(request.resource.data.assetPath, c, uid());
        allow delete: if admin(c) || isStaff() || resource.data.by == uid();
      }
      match /tables/{t} {
        allow read: if member(c) || isStaff();
        allow create, update: if member(c) && active();
        allow delete: if admin(c) || isStaff();
      }
      match /events/{e} {
        allow read: if member(c) || isStaff();
        allow create, update: if member(c) && active();
        allow delete: if admin(c) || isStaff();
      }
    }

    match /assets/{assetId} {
      allow read: if canReadAsset(assetId);
      allow create: if validAssetCreate();
      allow update: if assetProgressUpdate(assetId) || finishAssetUpload();
      allow delete: if canDeleteAsset(assetId);
      match /chunks/{chunkId} {
        allow read: if canReadAsset(assetId);
        allow create: if validAssetChunk(assetId, chunkId);
        allow update: if false;
        allow delete: if canDeleteAsset(assetId);
      }
    }

    match /posts/{p} {
      allow read: if true;
      allow create: if active()
        && request.resource.data.keys().hasOnly(['uid', 'by', 't', 'x', 'i', 'assetId', 'likes', 'comments', 'views'])
        && request.resource.data.keys().hasAll(['uid', 'by', 't', 'x', 'i', 'likes', 'comments', 'views'])
        && request.resource.data.uid == uid()
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.t is int
        && request.resource.data.x is string
        && request.resource.data.x.size() <= 5000
        && request.resource.data.i is string
        && request.resource.data.i.size() <= 750000
        && attachablePostAsset(request.resource.data.get('assetId', ''))
        && request.resource.data.likes == []
        && request.resource.data.comments == []
        && request.resource.data.views == 0;
      allow update: if isStaff()
        || (signed() && postLikeUpdate())
        || (signed() && postCommentUpdate())
        || (signed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views is int
            && request.resource.data.views == resource.data.views + 1);
      allow delete: if isStaff() || (signed() && resource.data.uid == uid());
      match /likes/{u} {
        allow read: if true;
        allow create, delete: if signed() && uid() == u;
      }
      match /comments/{k} {
        allow read: if true;
        allow create: if active() && request.resource.data.by == uid();
        allow delete: if isStaff() || (signed() && resource.data.by == uid());
      }
    }

    match /tickets/{t} {
      allow read: if signed() && (resource.data.by == uid() || isStaff());
      allow create: if active() && request.resource.data.by == uid()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.x is string && request.resource.data.x.size() > 0
        && request.resource.data.x.size() <= 5000
        && request.resource.data.m is list && request.resource.data.m.size() == 1
        && request.resource.data.m[0].uid == uid()
        && request.resource.data.m[0].f == request.auth.token.email;
      allow update: if isStaff() || (signed() && resource.data.by == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['m'])
        && resource.data.m is list && request.resource.data.m is list
        && request.resource.data.m.size() == resource.data.m.size() + 1
        && request.resource.data.m.hasAll(resource.data.m)
        && request.resource.data.m[resource.data.m.size()].uid == uid()
        && request.resource.data.m[resource.data.m.size()].f == request.auth.token.email
        && request.resource.data.m[resource.data.m.size()].x is string
        && request.resource.data.m[resource.data.m.size()].x.size() > 0
        && request.resource.data.m[resource.data.m.size()].x.size() <= 5000
        && request.resource.data.m[resource.data.m.size()].t is int);
      match /messages/{m} {
        allow read: if signed() && (get(/databases/$(db)/documents/tickets/$(t)).data.by == uid() || isStaff());
        allow create: if signed() && request.resource.data.from == uid()
          && (get(/databases/$(db)/documents/tickets/$(t)).data.by == uid() || isStaff());
      }
    }

    match /scraps/{s} {
      allow read: if true;
      allow create: if active()
        && request.resource.data.keys().hasOnly(['by', 'f', 'toUid', 'x', 't'])
        && request.resource.data.by == uid()
        && request.resource.data.f == request.auth.token.email
        && request.resource.data.toUid is string
        && request.resource.data.toUid != uid()
        && request.resource.data.x is string
        && request.resource.data.x.size() > 0
        && request.resource.data.x.size() <= 2000
        && request.resource.data.t is int;
      allow update, delete: if isStaff()
        || (signed() && uid() == resource.data.by);
    }

    match /audit/{a} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.by == request.auth.token.email;
    }

    match /billingIntents/{intent} { allow read, write: if false; }
    match /billingReceipts/{receipt} { allow read, write: if false; }
    match /planExpirations/{expiration} { allow read, write: if false; }
  }
}
